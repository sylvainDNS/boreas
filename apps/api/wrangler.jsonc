{
  "name": "boreas-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs (observabilité) : `enabled` est l'interrupteur maître — il doit
  // être à true pour que quoi que ce soit soit collecté (le bloc proposé par le
  // Dashboard mettait `enabled: false` en racine, ce qui n'aurait rien loggué).
  // `head_sampling_rate: 1` = on garde 100 % des invocations. Les traces (beta)
  // restent désactivées.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  // Variables non secrètes. HMAC_SECRET est posé séparément (secret Worker,
  // partagé avec boreas-cron). En local, .dev.vars surcharge ces valeurs
  // (ENVIRONMENT=development → e-mail mocké, APP_BASE_URL=localhost).
  "vars": {
    "EMAIL_FROM": "noreply@boreas.sylvaindenyse.me",
    "APP_BASE_URL": "https://boreas.sylvaindenyse.me",
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boreas",
      "database_id": "d3879d06-37b7-4d48-ac02-cc8a4f7718f8"
    }
  ],
  // Queue d'ingestion : l'API en est producteur (POST /api/refresh enqueue un
  // message par Feed). Le consommateur vit dans boreas-cron. (ADR 0002, #10)
  "queues": {
    "producers": [
      {
        "queue": "boreas-ingestion",
        "binding": "INGESTION_QUEUE"
      }
    ]
  },
  // R2 : HTML plein extrait (articles/{id}.html) + images proxifiées (images/{hash}). (ADR 0004/0009)
  // Bindé dès maintenant ; consommé à partir de #7/#9.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "boreas"
    }
  ],
  // Envoi du magic link via Cloudflare Email Service (domaine expéditeur
  // boreas.sylvaindenyse.me vérifié dans « Email Sending »). On restreint
  // l'adresse expéditrice ; le destinataire est borné applicativement à
  // l'allowed_email. (ADR 0005)
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_sender_addresses": ["noreply@boreas.sylvaindenyse.me"]
    }
  ]
}
