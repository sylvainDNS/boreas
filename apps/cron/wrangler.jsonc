{
  "name": "boreas-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],
  // Workers Logs (observabilité). `enabled` racine = interrupteur maître (doit
  // être true pour collecter). Particulièrement utile ici : ce worker est le
  // consommateur de la Queue d'ingestion, donc les échecs de fetch/parsing de
  // flux y remontent. `head_sampling_rate: 1` = 100 % des invocations.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  // Web Push (#80) : le consommateur de Queue émet un push par Feed ayant des
  // articles net-new. VAPID_PRIVATE_KEY est un secret Worker (posé via
  // `wrangler secret put`, MÊME paire que boreas-api). VAPID_PUBLIC_KEY (point
  // P-256 brut base64url) et VAPID_SUBJECT ne sont pas secrets. En local,
  // .dev.vars surcharge avec la paire jetable de dev.
  "vars": {
    "VAPID_PUBLIC_KEY": "BMgR-UrYVwD2XDYIbhnADIml3lqInfFdqlJt8GC09p2BlQ5IYrIH-M66sffxm9f3qCbzeknsYzBqC4aSD8Wm1IM",
    "VAPID_SUBJECT": "mailto:contact@boreas.sylvaindenyse.me"
  },
  "queues": {
    // Le Cron est à la fois producteur (scheduled → enqueue les feeds dus)
    // et consommateur (queue → ingère chaque feed) de boreas-ingestion. (ADR 0002)
    "producers": [
      {
        "queue": "boreas-ingestion",
        "binding": "INGESTION_QUEUE"
      }
    ],
    "consumers": [
      {
        "queue": "boreas-ingestion",
        "max_batch_size": 10,
        "max_retries": 3
      }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "boreas",
      "database_id": "d3879d06-37b7-4d48-ac02-cc8a4f7718f8"
    }
  ],
  // R2 : le Cron écrit le HTML plein extrait à l'ingestion (articles/{id}.html). (ADR 0004/0009)
  // Bindé dès maintenant ; consommé à partir de #7/#9.
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "boreas"
    }
  ]
}
