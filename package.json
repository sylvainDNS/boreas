{
  "private": true,
  "name": "boreas",
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present run dev",
    "dev:api": "wrangler dev --config apps/api/wrangler.jsonc --persist-to .wrangler/state",
    "dev:cron": "wrangler dev --config apps/cron/wrangler.jsonc --persist-to .wrangler/state",
    "dev:web": "pnpm --filter @boreas/web dev",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local --persist-to .wrangler/state --config packages/shared/wrangler.jsonc",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r --if-present build",
    "deploy:migrate": "wrangler d1 migrations apply DB --remote --config packages/shared/wrangler.jsonc",
    "deploy:api": "wrangler deploy --config apps/api/wrangler.jsonc",
    "deploy:cron": "wrangler deploy --config apps/cron/wrangler.jsonc",
    "deploy:web": "pnpm --filter @boreas/web build && pnpm --filter @boreas/web deploy",
    "deploy": "pnpm deploy:migrate && pnpm deploy:api && pnpm deploy:cron && pnpm deploy:web"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "drizzle-kit": "^0.31.10",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7",
    "wrangler": "^4.95.0"
  }
}
